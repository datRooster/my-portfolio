{
  "name": "my-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/clean-assets.mjs && tsc --noEmit && vite build && node scripts/package-hosting.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test:api": "node tests/api-smoke.mjs",
    "setup:mamp": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/setup-mamp.ps1",
    "test:browser": "node tests/browser-smoke.mjs",
    "test:portfolio": "node tests/portfolio-browser.mjs",
    "test:home": "node tests/home-browser.mjs",
    "test:site": "node tests/site-noir-browser.mjs",
    "package:aruba": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/package-aruba.ps1"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.545.0",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-router-dom": "^7.0.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9",
    "globals": "^16",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vite": "^8.3.3"
  }
}
